# Discourse connection (server-side only; never prefix these with NEXT_PUBLIC_).
# Leave DISCOURSE_URL or DISCOURSE_API_KEY empty to run the UI on built-in demo data.
DISCOURSE_URL=https://community.assetvantage.com
# Admin -> API -> New API Key. Use "All users" scope so posts can be made as members.
DISCOURSE_API_KEY=
# Username the API acts as (author of new posts, replies, votes and bookmarks).
DISCOURSE_API_USERNAME=system

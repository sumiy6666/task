# Discourse forum the app reads from and posts to. Leave empty to run the UI on
# built-in demo data (each visitor's demo posts are kept in their own browser).
DISCOURSE_URL=https://community.assetvantage.com

# Member sign-in with AV Community accounts. Set to false to switch it off for
# testing: everyone then posts through DISCOURSE_API_KEY, or the app runs on
# demo data if no key is set.
SIGN_IN_ENABLED=true

# Public URL of this app, used for the sign-in callback. Optional: defaults to
# the URL the request came in on. Must match an entry in Discourse's
# "allowed user api auth redirects" site setting (see README).
APP_URL=

# Optional admin key (Admin -> API -> New API Key). Not needed for members:
# they sign in with their own AV Community account. When set, guests' reads use
# it, and a guest's posts are made as DISCOURSE_API_USERNAME.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
